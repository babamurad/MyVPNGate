unit Main;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, IdBaseComponent, IdComponent,
  IdTCPConnection, IdTCPClient, IdHTTP, Vcl.Grids, Vcl.StdCtrls, Vcl.ExtCtrls,
  Clipbrd, System.NetEncoding,
  System.Net.URLClient, System.Net.HttpClient, System.Net.HttpClientComponent,
  Vcl.ComCtrls, System.ImageList, Vcl.ImgList, Vcl.Menus;

type
  TForm1 = class; // Предварительное объявление

  // Поток проверки TCP-соединения с привязкой к строке StringGrid
  TTCPCheckThread = class(TThread)
  private
    FForm: TForm1;
    FRowIndex: Integer;
    FIP: string;
    FPort: Integer;
    FStatus: string;
    procedure UpdateUI;
  protected
    procedure Execute; override;
  public
    constructor Create(AForm: TForm1; ARowIndex: Integer; AIP: string; APort: Integer);
  end;

  // Фоновый поток для скачивания и парсинга серверов
  TUpdateThread = class(TThread)
  private
    FForm: TForm1;
    FErrorMessage: string;
    FSuccess: Boolean;
    FTempServers: TStringList;
    procedure UpdateUI;
  protected
    procedure Execute; override;
  public
    constructor Create(AForm: TForm1);
    destructor Destroy; override;
  end;

  TForm1 = class(TForm)
    Panel1: TPanel;
    Button1: TButton;
    Button2: TButton;
    Button3: TButton;
    StringGrid1: TStringGrid;
    NetHTTPClient1: TNetHTTPClient;
    ProgressBar1: TProgressBar;
    ImageList1: TImageList;
    StatusBar1: TStatusBar;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure NetHTTPClient1ValidateServerCertificate(const Sender: TObject;
      const ARequest: TURLRequest; const Certificate: TCertificate;
      var Accepted: Boolean);
    procedure StringGrid1DrawCell(Sender: TObject; ACol, ARow: Integer;
      Rect: TRect; State: TGridDrawState);
    procedure FormResize(Sender: TObject);
    procedure StringGrid1Click(Sender: TObject);
    procedure StringGrid1MouseDown(Sender: TObject; Button: TMouseButton;
      Shift: TShiftState; X, Y: Integer);
  private
    FOVPNList: TStringList;     // Список Base64 строк .ovpn конфигураций для каждой строки
    FSortedCol: Integer;        // Текущая отсортированная колонка
    FSortAscending: Boolean;    // Направление сортировки
    PopupMenu1: TPopupMenu;     // Контекстное меню
    MenuItemCopyIP: TMenuItem;
    MenuItemCopyPort: TMenuItem;
    MenuItemCheckOne: TMenuItem;
    MenuItemSaveOVPN: TMenuItem;

    procedure SaveListToFile;
    procedure UpdateStats;
    procedure CreatePopupMenuItems;
    procedure MenuCopyIPClick(Sender: TObject);
    procedure MenuCopyPortClick(Sender: TObject);
    procedure MenuCheckOneClick(Sender: TObject);
    procedure MenuSaveOVPNClick(Sender: TObject);
  public
    { Public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

{ TTCPCheckThread }

constructor TTCPCheckThread.Create(AForm: TForm1; ARowIndex: Integer; AIP: string; APort: Integer);
begin
  inherited Create(False);
  FreeOnTerminate := True;
  FForm := AForm;
  FRowIndex := ARowIndex;
  FIP := AIP;
  FPort := APort;
end;

procedure TTCPCheckThread.UpdateUI;
begin
  if FRowIndex < FForm.StringGrid1.RowCount then
    FForm.StringGrid1.Cells[5, FRowIndex] := FStatus;
end;

procedure TTCPCheckThread.Execute;
var
  TCPClient: TIdTCPClient;
begin
  TCPClient := TIdTCPClient.Create(nil);
  try
    TCPClient.Host := FIP;
    TCPClient.Port := FPort;
    TCPClient.ConnectTimeout := 2000;
    TCPClient.ReadTimeout := 2000;
    try
      TCPClient.Connect;
      FStatus := 'Работает!';
    except
      FStatus := 'Недоступен';
    end;
    try
      if TCPClient.Connected then
        TCPClient.Disconnect;
    except
    end;
  finally
    TCPClient.Free;
  end;
  Synchronize(UpdateUI);
end;

{ TForm1 }

procedure TForm1.FormCreate(Sender: TObject);
var
  SL, Columns: TStringList;
  i: Integer;
  FilePath: string;
  RowIdx: Integer;
begin
  FOVPNList := TStringList.Create;
  FSortedCol := -1;
  FSortAscending := True;

  // Создаем контекстное меню программно
  CreatePopupMenuItems;

  StringGrid1.ColCount := 6;
  StringGrid1.FixedRows := 1;
  StringGrid1.RowCount := 2;

  // Заголовки колонок
  StringGrid1.Cells[0, 0] := '№';
  StringGrid1.Cells[1, 0] := 'IP';
  StringGrid1.Cells[2, 0] := 'Порт';
  StringGrid1.Cells[3, 0] := 'Страна';
  StringGrid1.Cells[4, 0] := 'Протокол';
  StringGrid1.Cells[5, 0] := 'Статус';

  // Ширина колонок
  StringGrid1.ColWidths[0] := 45;
  StringGrid1.ColWidths[1] := 140;
  StringGrid1.ColWidths[2] := 70;
  StringGrid1.ColWidths[3] := 130;
  StringGrid1.ColWidths[4] := 80;
  StringGrid1.ColWidths[5] := 150;

  StringGrid1.DoubleBuffered := True;
  StringGrid1.Options := StringGrid1.Options + [goRowSelect];
  StringGrid1.Options := StringGrid1.Options - [goEditing];
  StringGrid1.PopupMenu := PopupMenu1;

  FilePath := ExtractFilePath(ParamStr(0)) + 'servers.txt';
  if not FileExists(FilePath) then Exit;

  SL := TStringList.Create;
  Columns := TStringList.Create;
  Columns.StrictDelimiter := True;
  Columns.Delimiter := ',';

  try
    SL.LoadFromFile(FilePath);
    if SL.Count > 0 then
      StringGrid1.RowCount := SL.Count + 1;

    RowIdx := 0;
    // Заполняем временный список OVPN пустыми строками для выравнивания
    FOVPNList.Add('');

    for i := 0 to SL.Count - 1 do
    begin
      if Trim(SL[i]) = '' then Continue;
      Columns.DelimitedText := SL[i];
      if Columns.Count >= 5 then
      begin
        Inc(RowIdx);
        StringGrid1.Cells[0, RowIdx] := IntToStr(RowIdx);
        StringGrid1.Cells[1, RowIdx] := Columns[0]; // IP
        StringGrid1.Cells[2, RowIdx] := Columns[1]; // Порт
        StringGrid1.Cells[3, RowIdx] := Columns[2]; // Страна
        StringGrid1.Cells[4, RowIdx] := Columns[3]; // Протокол
        StringGrid1.Cells[5, RowIdx] := Columns[4]; // Статус

        if Columns.Count >= 6 then
          FOVPNList.Add(Columns[5])
        else
          FOVPNList.Add('');
      end;
    end;

    if RowIdx > 0 then
      StringGrid1.RowCount := RowIdx + 1
    else
      StringGrid1.RowCount := 2;
  finally
    SL.Free;
    Columns.Free;
  end;

  UpdateStats;
end;

procedure TForm1.FormDestroy(Sender: TObject);
begin
  FOVPNList.Free;
end;

procedure TForm1.CreatePopupMenuItems;
begin
  PopupMenu1 := TPopupMenu.Create(Self);

  MenuItemCopyIP := TMenuItem.Create(PopupMenu1);
  MenuItemCopyIP.Caption := 'Скопировать IP';
  MenuItemCopyIP.OnClick := MenuCopyIPClick;
  PopupMenu1.Items.Add(MenuItemCopyIP);

  MenuItemCopyPort := TMenuItem.Create(PopupMenu1);
  MenuItemCopyPort.Caption := 'Скопировать порт';
  MenuItemCopyPort.OnClick := MenuCopyPortClick;
  PopupMenu1.Items.Add(MenuItemCopyPort);

  MenuItemCheckOne := TMenuItem.Create(PopupMenu1);
  MenuItemCheckOne.Caption := 'Проверить этот сервер';
  MenuItemCheckOne.OnClick := MenuCheckOneClick;
  PopupMenu1.Items.Add(MenuItemCheckOne);

  MenuItemSaveOVPN := TMenuItem.Create(PopupMenu1);
  MenuItemSaveOVPN.Caption := 'Сохранить .ovpn файл...';
  MenuItemSaveOVPN.OnClick := MenuSaveOVPNClick;
  PopupMenu1.Items.Add(MenuItemSaveOVPN);
end;

procedure TForm1.MenuCopyIPClick(Sender: TObject);
var
  Row: Integer;
begin
  Row := StringGrid1.Row;
  if (Row > 0) and (Trim(StringGrid1.Cells[1, Row]) <> '') then
  begin
    Clipboard.AsText := StringGrid1.Cells[1, Row];
  end;
end;

procedure TForm1.MenuCopyPortClick(Sender: TObject);
var
  Row: Integer;
begin
  Row := StringGrid1.Row;
  if (Row > 0) and (Trim(StringGrid1.Cells[2, Row]) <> '') then
  begin
    Clipboard.AsText := StringGrid1.Cells[2, Row];
  end;
end;

procedure TForm1.MenuCheckOneClick(Sender: TObject);
var
  Row: Integer;
begin
  Row := StringGrid1.Row;
  if (Row > 0) and (Trim(StringGrid1.Cells[1, Row]) <> '') then
  begin
    StringGrid1.Cells[5, Row] := 'Проверка...';
    TTCPCheckThread.Create(Self, Row, StringGrid1.Cells[1, Row], StrToIntDef(StringGrid1.Cells[2, Row], 443));
  end;
end;

procedure TForm1.MenuSaveOVPNClick(Sender: TObject);
var
  Row: Integer;
  SaveDlg: TSaveDialog;
  DecodedBytes: TBytes;
  Stream: TFileStream;
  Base64Str: string;
begin
  Row := StringGrid1.Row;
  if (Row <= 0) or (Row >= FOVPNList.Count) then Exit;

  Base64Str := FOVPNList[Row];
  if Trim(Base64Str) = '' then
  begin
    ShowMessage('Для этого сервера отсутствует конфигурация OpenVPN.');
    Exit;
  end;

  SaveDlg := TSaveDialog.Create(Self);
  try
    SaveDlg.Title := 'Сохранить .ovpn конфигурацию';
    SaveDlg.Filter := 'OpenVPN Config (*.ovpn)|*.ovpn|All Files (*.*)|*.*';
    SaveDlg.DefaultExt := 'ovpn';
    SaveDlg.FileName := StringGrid1.Cells[1, Row] + '_' + StringGrid1.Cells[3, Row] + '.ovpn';

    if SaveDlg.Execute then
    begin
      try
        DecodedBytes := TNetEncoding.Base64.DecodeStringToBytes(Base64Str);
        Stream := TFileStream.Create(SaveDlg.FileName, fmCreate);
        try
          if Length(DecodedBytes) > 0 then
            Stream.WriteBuffer(DecodedBytes[0], Length(DecodedBytes));
        finally
          Stream.Free;
        end;
        ShowMessage('Файл успешно сохранен!');
      except
        on E: Exception do
          ShowMessage('Ошибка сохранения файла: ' + E.Message);
      end;
    end;
  finally
    SaveDlg.Free;
  end;
end;

procedure TForm1.FormResize(Sender: TObject);
var
  TotalWidth: Integer;
begin
  if Assigned(StringGrid1) and (StringGrid1.ColCount = 6) then
  begin
    TotalWidth := StringGrid1.ClientWidth - StringGrid1.ColWidths[0] -
                  StringGrid1.ColWidths[1] - StringGrid1.ColWidths[2] -
                  StringGrid1.ColWidths[3] - StringGrid1.ColWidths[4] - 20;
    if TotalWidth > 150 then
      StringGrid1.ColWidths[5] := TotalWidth;
  end;
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  Button1.Visible := False;
  ProgressBar1.Left := Button1.Left;
  ProgressBar1.Top := Button1.Top;
  ProgressBar1.Width := Button1.Width;
  ProgressBar1.Height := Button1.Height;
  ProgressBar1.Visible := True;

  TUpdateThread.Create(Self);
end;

procedure TForm1.Button2Click(Sender: TObject);
var
  i: Integer;
begin
  for i := 1 to StringGrid1.RowCount - 1 do
  begin
    if Trim(StringGrid1.Cells[1, i]) <> '' then
    begin
      StringGrid1.Cells[5, i] := 'Проверка...';
      TTCPCheckThread.Create(Self, i, StringGrid1.Cells[1, i], StrToIntDef(StringGrid1.Cells[2, i], 443));
    end;
  end;
end;

procedure TForm1.Button3Click(Sender: TObject);
var
  i: Integer;
  TempList: TStringList;
  TempOVPN: TStringList;
  Cols: TArray<string>;
  RIdx: Integer;
begin
  TempList := TStringList.Create;
  TempOVPN := TStringList.Create;
  try
    TempOVPN.Add('');
    for i := 1 to StringGrid1.RowCount - 1 do
    begin
      if StringGrid1.Cells[5, i] = 'Работает!' then
      begin
        TempList.Add(StringGrid1.Cells[1, i] + ',' +
                     StringGrid1.Cells[2, i] + ',' +
                     StringGrid1.Cells[3, i] + ',' +
                     StringGrid1.Cells[4, i] + ',' +
                     StringGrid1.Cells[5, i]);
        if i < FOVPNList.Count then
          TempOVPN.Add(FOVPNList[i])
        else
          TempOVPN.Add('');
      end;
    end;

    FOVPNList.Assign(TempOVPN);

    if TempList.Count > 0 then
      StringGrid1.RowCount := TempList.Count + 1
    else
    begin
      StringGrid1.RowCount := 2;
      for i := 0 to 5 do
        StringGrid1.Cells[i, 1] := '';
      UpdateStats;
      SaveListToFile;
      Exit;
    end;

    for i := 0 to TempList.Count - 1 do
    begin
      RIdx := i + 1;
      Cols := TempList[i].Split([',']);
      if Length(Cols) >= 5 then
      begin
        StringGrid1.Cells[0, RIdx] := IntToStr(RIdx);
        StringGrid1.Cells[1, RIdx] := Cols[0];
        StringGrid1.Cells[2, RIdx] := Cols[1];
        StringGrid1.Cells[3, RIdx] := Cols[2];
        StringGrid1.Cells[4, RIdx] := Cols[3];
        StringGrid1.Cells[5, RIdx] := Cols[4];
      end;
    end;
  finally
    TempList.Free;
    TempOVPN.Free;
  end;
  SaveListToFile;
  UpdateStats;
end;

procedure TForm1.StringGrid1DrawCell(Sender: TObject; ACol, ARow: Integer;
  Rect: TRect; State: TGridDrawState);
var
  HeaderText: string;
begin
  // Отрисовка заголовков с учетом стрелочки сортировки
  if ARow = 0 then
  begin
    StringGrid1.Canvas.Brush.Color := clBtnFace;
    StringGrid1.Canvas.FillRect(Rect);
    StringGrid1.Canvas.Font.Color := clBlack;
    StringGrid1.Canvas.Font.Style := [fsBold];

    HeaderText := StringGrid1.Cells[ACol, ARow];
    if ACol = FSortedCol then
    begin
      if FSortAscending then
        HeaderText := HeaderText + ' ▲'
      else
        HeaderText := HeaderText + ' ▼';
    end;

    StringGrid1.Canvas.TextRect(Rect, Rect.Left + 6, Rect.Top + 6, HeaderText);
    Exit;
  end;

  // Отрисовка обычных строк
  if gdSelected in State then
    StringGrid1.Canvas.Brush.Color := $003A3A3A
  else if ARow mod 2 = 0 then
    StringGrid1.Canvas.Brush.Color := $00252525
  else
    StringGrid1.Canvas.Brush.Color := $001E1E1E;

  StringGrid1.Canvas.FillRect(Rect);

  if ACol = 5 then
  begin
    if StringGrid1.Cells[ACol, ARow] = 'Работает!' then
      StringGrid1.Canvas.Font.Color := $0066CC33
    else if StringGrid1.Cells[ACol, ARow] = 'Недоступен' then
      StringGrid1.Canvas.Font.Color := $005555FF
    else if StringGrid1.Cells[ACol, ARow] = 'Проверка...' then
      StringGrid1.Canvas.Font.Color := $0033CCFF
    else
      StringGrid1.Canvas.Font.Color := clSilver;
    StringGrid1.Canvas.Font.Style := [fsBold];
  end
  else
  begin
    StringGrid1.Canvas.Font.Color := clWhite;
    StringGrid1.Canvas.Font.Style := [];
  end;

  StringGrid1.Canvas.TextRect(Rect, Rect.Left + 8, Rect.Top + 6, StringGrid1.Cells[ACol, ARow]);
end;

procedure TForm1.UpdateStats;
var
  i, Total, Working: Integer;
begin
  Total := 0;
  Working := 0;

  for i := 1 to StringGrid1.RowCount - 1 do
  begin
    if Trim(StringGrid1.Cells[1, i]) <> '' then
    begin
      Inc(Total);
      if StringGrid1.Cells[5, i] = 'Работает!' then
        Inc(Working);
    end;
  end;

  StatusBar1.Panels[0].Text := 'Всего серверов: ' + IntToStr(Total);
  StatusBar1.Panels[1].Text := 'Работает: ' + IntToStr(Working);
end;

procedure TForm1.StringGrid1Click(Sender: TObject);
begin
  // Клик по строке (оставляем пустым или под быстрые действия, основные функции теперь в контекстном меню)
end;

procedure TForm1.StringGrid1MouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  ACol, ARow: Integer;
  i, j: Integer;
  TempRow: TArray<string>;
  TempOVPN: string;
  Swapped: Boolean;
  CompareResult: Integer;
begin
  StringGrid1.MouseToCell(X, Y, ACol, ARow);

  // Клик по шапке для колонок IP (1), Порт (2), Страна (3)
  if (ARow = 0) and (ACol >= 1) and (ACol <= 3) then
  begin
    if FSortedCol = ACol then
      FSortAscending := not FSortAscending
    else
    begin
      FSortedCol := ACol;
      FSortAscending := True;
    end;

    SetLength(TempRow, StringGrid1.ColCount);

    repeat
      Swapped := False;
      for i := 1 to StringGrid1.RowCount - 2 do
      begin
        if Trim(StringGrid1.Cells[1, i]) = '' then Break;

        if ACol = 2 then // Числовое сравнение для порта
        begin
          if FSortAscending then
            CompareResult := Ord(StrToIntDef(StringGrid1.Cells[ACol, i], 0) > StrToIntDef(StringGrid1.Cells[ACol, i + 1], 0))
          else
            CompareResult := Ord(StrToIntDef(StringGrid1.Cells[ACol, i], 0) < StrToIntDef(StringGrid1.Cells[ACol, i + 1], 0));
        end
        else // Текстовое сравнение
        begin
          if FSortAscending then
            CompareResult := Ord(AnsiCompareText(StringGrid1.Cells[ACol, i], StringGrid1.Cells[ACol, i + 1]) > 0)
          else
            CompareResult := Ord(AnsiCompareText(StringGrid1.Cells[ACol, i], StringGrid1.Cells[ACol, i + 1]) < 0);
        end;

        if CompareResult = 1 then
        begin
          // Меняем местами строки в Grid
          for j := 0 to StringGrid1.ColCount - 1 do
          begin
            TempRow[j] := StringGrid1.Cells[j, i];
            StringGrid1.Cells[j, i] := StringGrid1.Cells[j, i + 1];
            StringGrid1.Cells[j, i + 1] := TempRow[j];
          end;

          // Синхронно меняем местами соответствующие OVPN конфиги в списке
          if (i < FOVPNList.Count) and (i + 1 < FOVPNList.Count) then
          begin
            TempOVPN := FOVPNList[i];
            FOVPNList[i] := FOVPNList[i + 1];
            FOVPNList[i + 1] := TempOVPN;
          end;

          Swapped := True;
        end;
      end;
    until not Swapped;

    // Обновляем порядковые номера (колонка 0)
    for i := 1 to StringGrid1.RowCount - 1 do
    begin
      if Trim(StringGrid1.Cells[1, i]) <> '' then
        StringGrid1.Cells[0, i] := IntToStr(i)
      else
        StringGrid1.Cells[0, i] := '';
    end;

    StringGrid1.Invalidate; // Перерисовываем со стрелочкой
  end;
end;

procedure TForm1.NetHTTPClient1ValidateServerCertificate(const Sender: TObject;
  const ARequest: TURLRequest; const Certificate: TCertificate;
  var Accepted: Boolean);
begin
  Accepted := True;
end;

procedure TForm1.SaveListToFile;
var
  SL: TStringList;
  i: Integer;
  OVPNStr: string;
begin
  SL := TStringList.Create;
  try
    for i := 1 to StringGrid1.RowCount - 1 do
    begin
      if Trim(StringGrid1.Cells[1, i]) <> '' then
      begin
        OVPNStr := '';
        if i < FOVPNList.Count then
          OVPNStr := FOVPNList[i];

        SL.Add(StringGrid1.Cells[1, i] + ',' + // IP
               StringGrid1.Cells[2, i] + ',' + // Порт
               StringGrid1.Cells[3, i] + ',' + // Страна
               StringGrid1.Cells[4, i] + ',' + // Протокол
               StringGrid1.Cells[5, i] + ',' + // Статус
               OVPNStr);                       // Base64 OVPN конфиг
      end;
    end;
    SL.SaveToFile(ExtractFilePath(ParamStr(0)) + 'servers.txt');
  finally
    SL.Free;
  end;
end;

{ TUpdateThread }

constructor TUpdateThread.Create(AForm: TForm1);
begin
  FForm := AForm;
  FTempServers := TStringList.Create;
  FSuccess := False;
  inherited Create(False);
  FreeOnTerminate := True;
end;

destructor TUpdateThread.Destroy;
begin
  FTempServers.Free;
  inherited;
end;

procedure TUpdateThread.Execute;
var
  Client: TNetHTTPClient;
  CSVData, OVPN, PortStr, Country: string;
  Lines, Columns, OVPNLines: TStringList;
  i, j, P: Integer;
begin
  Client := TNetHTTPClient.Create(nil);
  Lines := TStringList.Create;
  Columns := TStringList.Create;
  OVPNLines := TStringList.Create;
  Columns.StrictDelimiter := True;
  Columns.Delimiter := ',';
  try
    try
      Client.UserAgent := 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36';
      CSVData := Client.Get('https://www.vpngate.net/api/iphone/').ContentAsString();
      FSuccess := True;
    except
      on E: Exception do
      begin
        FErrorMessage := E.Message;
        FSuccess := False;
        Exit;
      end;
    end;

    if FSuccess then
    begin
      Lines.Text := CSVData;
      for i := 0 to Lines.Count - 1 do
      begin
        if (Trim(Lines[i]) = '') or (Lines[i][1] = '*') then Continue;
        Columns.DelimitedText := Lines[i];
        if (Columns.Count > 1) and (Columns[1] = 'IP') then Continue;

        if Columns.Count > 14 then
        begin
          PortStr := '443';
          Country := 'Unknown';
          if Columns.Count > 5 then
            Country := Columns[5];

          OVPN := Columns[14]; // Базовый Base64 конфиг из API

          try
            AILE: string;
            AILE := TNetEncoding.Base64.Decode(Columns[14]);
            OVPNLines.Text := AILE;

            for j := 0 to OVPNLines.Count - 1 do
            begin
              if Pos('remote ', Trim(OVPNLines[j])) = 1 then
              begin
                PortStr := Trim(OVPNLines[j]);
                Delete(PortStr, 1, 7);
                PortStr := Trim(PortStr);
                P := Pos(' ', PortStr);
                if P > 0 then
                begin
                  Delete(PortStr, 1, P);
                  PortStr := Trim(PortStr);
                  Break;
                end;
              end;
            end;
          except
          end;

          // Формат строки: IP, Порт, Страна, Протокол, Статус | Base64OVPN
          FTempServers.Add(Columns[1] + ',' + PortStr + ',' + Country + ',TCP,Ожидание|' + OVPN);
        end;
      end;
    end;
  finally
    Client.Free;
    Lines.Free;
    Columns.Free;
    OVPNLines.Free;
  end;

  Synchronize(UpdateUI);
end;

procedure TUpdateThread.UpdateUI;
var
  i: Integer;
  Parts: TArray<string>;
  Cols: TArray<string>;
  RowIdx: Integer;
begin
  FForm.ProgressBar1.Visible := False;
  FForm.Button1.Visible := True;

  if not FSuccess then
  begin
    ShowMessage('Ошибка скачивания: ' + FErrorMessage);
    Exit;
  end;

  FForm.FOVPNList.Clear;
  FForm.FOVPNList.Add(''); // Пустой элемент для хедера

  if FTempServers.Count > 0 then
    FForm.StringGrid1.RowCount := FTempServers.Count + 1
  else
    FForm.StringGrid1.RowCount := 2;

  for i := 0 to FTempServers.Count - 1 do
  begin
    RowIdx := i + 1;
    Parts := FTempServers[i].Split(['|']); // Разделяем параметры и сам Base64 OVPN
    if Length(Parts) >= 2 then
    begin
      FForm.FOVPNList.Add(Parts[1]);
      Cols := Parts[0].Split([',']);
      if Length(Cols) >= 5 then
      begin
        FForm.StringGrid1.Cells[0, RowIdx] := IntToStr(RowIdx); // №
        FForm.StringGrid1.Cells[1, RowIdx] := Cols[0];          // IP
        FForm.StringGrid1.Cells[2, RowIdx] := Cols[1];          // Порт
        FForm.StringGrid1.Cells[3, RowIdx] := Cols[2];          // Страна
        FForm.StringGrid1.Cells[4, RowIdx] := Cols[3];          // Протокол
        FForm.StringGrid1.Cells[5, RowIdx] := Cols[4];          // Статус
      end;
    end;
  end;

  FForm.SaveListToFile;
  FForm.UpdateStats;
end;

end.
